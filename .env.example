# ==========================================
# AFRI-CODE — VARIABLES D'ENVIRONNEMENT EXEMPLES
# ==========================================
# Copiez ce fichier en '.env' ou '.env.local' et renseignez vos valeurs réelles.
# NE JAMAIS COMMITER LE FICHIER .env CONTENANT DES CLÉS PRIVÉES DANS GIT !

# Numéro WhatsApp officiel Afri-code (format international sans le +, ex: 226XXXXXXXX)
AFRI_WHATSAPP_NUMBER=22600000000
AFRI_WHATSAPP_DEFAULT_MESSAGE="Bonjour Afri-code, je souhaite échanger au sujet d'un projet numérique pour mon entreprise."

# E-mail de contact officiel
AFRI_CONTACT_EMAIL=contact@afri-code.bf

# Clé de protection anti-robot (Cloudflare Turnstile ou Google reCAPTCHA)
# La clé publique (sitekey) peut être injectée dans le frontend
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxxxxxx

# Clé secrète pour la vérification serveur (SSR / Serverless)
SECRET_TURNSTILE_SECRET_KEY=0x4AAAAAAyyyyyyyyyyyyyyyyyyy

# URL de l'API d'envoi d'e-mail (Resend, Brevo ou endpoint Express)
API_CONTACT_ENDPOINT=https://api.afri-code.bf/api/contact
